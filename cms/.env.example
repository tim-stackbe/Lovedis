# Lovedis CMS (Payload) — copy to `.env` (local) or `cms.env` (server). NEVER commit the real file.
# All values below are PLACEHOLDERS. Do not put real secrets in this file.

# --- Payload ---
# Long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=generate-a-long-random-string

# Public URL the admin/API is served from (used for CORS/CSRF + cookies).
# Local:  http://localhost:3001
# Server: https://cms.lovedis.de
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# --- Database (same Postgres instance as the platform; ISOLATED `payload` schema) ---
# The platform's Prisma owns `public`; Payload owns `payload`. One DB, one backup.
# Server (compose network): postgresql://lovedis:PASSWORD@db:5432/lovedis?schema=payload
# Local verification example:  postgresql://lovedis:lovedis@localhost:5434/lovedis?schema=payload
DATABASE_URI=postgresql://lovedis:change-me@db:5432/lovedis?schema=payload

# Postgres schema Payload/Drizzle manages (keeps CMS tables out of `public`).
PAYLOAD_DB_SCHEMA=payload

# Modest pool cap so platform + cms + backups stay within Postgres max_connections.
PAYLOAD_DB_POOL_MAX=10

# --- Media / object storage (S3-compatible: Cloudflare R2 or Hetzner Object Storage) ---
# Reuses the platform's S3_* env var names. For R2: region=auto, forcePathStyle=true.
# R2 endpoint:      https://<accountid>.r2.cloudflarestorage.com
# Hetzner endpoint: https://<region>.your-objectstorage.com
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lovedis-media
S3_ACCESS_KEY_ID=xxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
# Optional: public base URL for served media (R2 public bucket / CDN / media.lovedis.de).
# Leave blank to serve uploads through Payload itself (dev default).
S3_PUBLIC_BASE_URL=

# --- Local-only fallback storage ---
# When set to `true`, uploads are written to ./media on local disk instead of S3.
# Handy for local verification without S3 credentials. Never enable on the server.
DISABLE_S3_STORAGE=false

# --- Homepage (Nuxt) origin — allowed for CORS/CSRF (needed later for Phase 2 live preview) ---
HOMEPAGE_URL=https://lovedis.de

# --- Live preview shared secret (Phase 2; harmless to set now) ---
PREVIEW_SECRET=generate-another-random-string

# --- First-run admin seed (used by `npm run seed:users`; do NOT hardcode real values) ---
CMS_ADMIN_EMAIL=admin@lovedis.de
CMS_ADMIN_PASSWORD=change-me-strong
CMS_EDITOR_EMAIL=editor@lovedis.de
CMS_EDITOR_PASSWORD=change-me-strong
