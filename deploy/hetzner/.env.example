# Copy to `.env` on the TEST server (never commit the real file).
#
# TEST box: 49.13.222.76 (lovedis-prod)
# Public URLs (nip.io — no lovedis.de DNS changes):
#   Platform:  https://app.49.13.222.76.nip.io
#   Homepage:  https://home.49.13.222.76.nip.io
#
# Production cutover (later): see Caddyfile.production.example + README § Production cutover.

# --- Container images built + pushed by CI ---
# Use :test tags on the TEST server; reserve :latest for production cutover.
PLATFORM_IMAGE=ghcr.io/OWNER/lovedis:test
HOMEPAGE_IMAGE=ghcr.io/OWNER/lovedis-homepage:test

# NOTE: the `homepage` service reads its OWN env file `homepage.env` (mode 600, never
# committed) — NOT this `.env`. See `homepage.env.example` for Storyblok tokens.

# --- PostgreSQL (runs on this same box, data on the Cloud Volume) ---
POSTGRES_USER=lovedis
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=lovedis

# --- Platform (Prisma uses the `public` schema) ---
DATABASE_URL=postgresql://lovedis:change-me-strong@db:5432/lovedis?schema=public

# --- Auth / secrets (must match the public TEST URL — NOT lovedis.de) ---
# NEXTAUTH_URL is the public origin used for auth redirects + emailed links.
# AUTH_TRUST_HOST=true means the app already trusts Caddy's X-Forwarded-Host,
# so a NEW hostname added in the Caddyfile serves logins immediately; you only
# need to update NEXTAUTH_URL so emailed links (invites, password resets) point
# at the new host. On the Alpha custom-domain cutover, change this to e.g.
#   NEXTAUTH_URL=https://alpha.lovedis.de
# and restart the platform container. Session cookies are host-scoped, so users
# on the old host keep working but must log in again on the new host.
NEXTAUTH_URL=https://alpha.lovedis.de
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Email (Resend) — use test-scoped keys on the TEST server ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=LOVEDIS <noreply@lovedis.de>

# --- DB backup ---
# Backup settings are NOT read from this file. backup-postgres.sh reads
# /opt/lovedis/backup.env (mode 600, server-side only) so the schedule keeps
# working independently of the application env. Backups run locally with no
# extra config; see "Enabling off-box backups" in README.md for the S3 vars.
