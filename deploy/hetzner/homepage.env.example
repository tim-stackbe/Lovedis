# Copy to `homepage.env` on the TEST server (mode 600, never commit).
# Used by the Nuxt homepage container only.
#
# The homepage fetches content from the same Storyblok LOVEDIS space as production.
# lovedis.de DNS is unchanged — this env is for the Hetzner TEST container only.

# Storyblok Delivery API — read-only token for the LOVEDIS space (EU).
# Get from Storyblok → Space settings → Access tokens → Preview/Delivery.
STORYBLOK_TOKEN=your-delivery-token
STORYBLOK_VERSION=published

# Optional: enable Storyblok Visual Editor bridge in preview/staging builds.
# STORYBLOK_PREVIEW_TOKEN=your-preview-token

# Default locale (matches Storyblok space: de default, en additional).
NUXT_PUBLIC_DEFAULT_LOCALE=de
