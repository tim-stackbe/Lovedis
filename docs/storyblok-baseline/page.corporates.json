{"story":{"name":"Corporates","created_at":"2025-12-09T20:40:21.378Z","published_at":"2026-03-27T09:59:16.224Z","updated_at":"2026-03-27T09:59:16.300Z","id":121336714796252,"uuid":"4ef4a429-6907-407f-9400-e83fec9d5b67","content":{"_uid":"ef1ac194-eeac-4950-9e29-e562b121e0e3","body":[{"_uid":"4daa27fa-9a8a-4c71-806f-004ddfa08aa2","visible":true,"cta_link":{"id":"4ef4a429-6907-407f-9400-e83fec9d5b67","url":"/contact","linktype":"story","fieldtype":"multilink","cached_url":"corporates"},"cta_text":"Partner werden","headline":"Für Unternehmen","_editable":"\u003c!--#storyblok#{\"name\": \"main-hero\", \"space\": \"288104308443570\", \"uid\": \"4daa27fa-9a8a-4c71-806f-004ddfa08aa2\", \"id\": \"121336714796252\"}--\u003e","component":"main-hero","cta_anchor":"partner-form","hero_image":{"id":136846897411956,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/4176x1488/8150dfc06c/hero-section-desktop.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"description":"Die Zukunft unserer Region formen wir gemeinsam. Wir machen Hessen „Startup-fähig“, indem wir etablierte Strukturen mit der Agilität junger Tech-Unternehmen verzahnen. \n\nSo entwickeln wir Mittelhessen zu einem relevanten Innovationsstandort, der Talente und Technologien anzieht.","hero_image_fit":"contain","hero_image_mask":"none","hero_image_zoom":"100","disable_animation":true,"fill_transparency":true,"hero_image_mobile":{"id":136846897416054,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/1074x1488/68d27ad343/hero-image-mobile.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"hero_image_tablet":{"id":136846897411955,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/2358x2238/f5669b17a2/hero-image-tablet.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":fa