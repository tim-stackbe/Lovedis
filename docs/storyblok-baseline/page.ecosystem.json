nce","disable_popup":false},{"_uid":"5a4a1187-91c3-490d-9bcb-469586b32b34","partner":"9a7628d8-d278-44d8-bb75-71e632ca9229","visible":true,"component":"partner-reference","disable_popup":false},{"_uid":"00fede29-f168-4c32-907c-28edd4af769f","partner":"0dc69558-10e5-4d59-8078-3451834b19da","visible":true,"component":"partner-reference","disable_popup":false}],"component":"sponsor-tier-row","level_label":"Corporate Partner"},{"_uid":"7de5f43d-b904-46aa-9d14-181b6bb0f0d9","visible":true,"partners":[{"_uid":"e1255cb9-3c5a-4431-a009-b8efab5c928a","partner":"c7284a28-be0a-4964-8af9-b94b9eb2aed5","visible":true,"component":"partner-reference","disable_popup":false},{"_uid":"54dcc735-9ec2-4353-8896-2f915655dd04","partner":"9b5192a8-fa5e-47b3-a60c-f5879239c451","visible":true,"component":"partner-reference","disable_popup":false},{"_uid":"08952f04-a762-46c1-8826-c6f10f224518","partner":"b050d742-ddd7-4600-8c66-95afba81cd7d","visible":true,"component":"partner-reference","disable_popup":false},{"_uid":"daf4218d-2d3b-4c2a-87ca-0c74f3e7f4de","partner":"acd1e75c-2f60-4003-a627-be4b43a7c2cc","visible":true,"component":"partner-reference","disable_popup":false}],"component":"sponsor-tier-row","level_label":"Sponsoren"}],"tagline":"Unser Corporate Ökosystem","visible":true,"cta_link":{"id":"2e57b196-3863-42eb-a200-4b3aba6e7162","url":"","linktype":"story","fieldtype":"multilink","cached_url":"ecosystem"},"headline":"Unsere Partner - Wo Weltmarktführer auf Zukunft treffen","component":"sponsor-partners-section","cta_label":"Partner werden","cta_anchor":"contact-form","section_id":"partners-glossary","description":"Unsere Partner verstehen Veränderung nicht als Risiko, sondern als strategischen Vorsprung.","show_filter":true},{"_uid":"4203ac1a-414b-44f4-bb17-dc48ac184858","tagline":"Entrepreneurship Support","visible":true,"headline":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"StartMiUp: Das universitätsgetragene Startup-Ökosystem in Mittelhessen","type":"text"}]}]},"component":"universities-section","section_id":"","text_color":"","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Der StartMiUp Campus ist der gemeinsame Innovations- und Startup-Campus der drei mittelhessischen Hochschulen – der Justus-Liebig-Universität Gießen, der Philipps-Universität Marburg und der Technischen Hochschule Mittelhessen. ","type":"text"},{"text":"Ziel ist es, eine lebendige Gründungskultur an den Hochschulen zu etablieren und Innovator:innen bestmöglich zu unterstützen – von der ersten Idee bis zur Umsetzung. Durch Workshops, Veranstaltungen und Netzwerke werden Studierende, Forschende und Alumni dabei begleitet, ihre unternehmerischen Potenziale zu entfalten.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#FFFFFF"}}]}]}]},"universities":[{"_uid":"9660fd66-95fe-490f-af36-4b485246cea3","name":"Justus Liebig Universität Giessen — ECM","image":{"id":136849654683643,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/870x870/3057defc52/justus-university-desktop.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"logos":[{"_uid":"51b38e81-e0fb-4fd3-a3de-49c7e71d9373","name":"JLU Giessen","image":{"id":136776059469624,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/131x48/cbfa517a58/jlu_giessen-logo.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"university-logo","image_quality":"100"},{"_uid":"0842260f-eda0-4d05-84aa-671501c1889a","name":"ECM","image":{"id":null,"alt":"ECM logo","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/a3d087f8c4/ecm-logo.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"university-logo","image_quality":""}],"component":"university-item","description":"\nDie Justus-Liebig-Universität Gießen ist eine forschungsstarke Universität mit besonderem Fokus auf Lebens- und Naturwissenschaften sowie interdisziplinäre Ansätze.","image_quality":"","additional_info":"[Hier geht's zum Gründungsservice ECM](https://www.uni-giessen.de/de/fbz/fb02/fb/einrichtungen/ecm)\n\n"},{"_uid":"78446790-0d9f-439e-8ca7-e43b13217cf4","name":"Philipps Universität Marburg - MAFEX","image":{"id":136849654683642,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/870x870/fc9e29c05c/philipps-university-desktop.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"logos":[{"_uid":"e1ef088b-7511-4ed7-aced-358f155f0ee5","name":"Philipps University Marburg","image":{"id":143125487643661,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/402x270/93cbf1713e/universitat-marburg.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"university-logo","image_quality":""},{"_uid":"91a5a5ea-c36e-423d-a0cc-e38206cad8a3","name":"MAFEX logo","image":{"id":161531155655840,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/288104308443570/627x282/7573f5d12f/mafexlogo.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"university-logo","image_quality":"107"}],"component":"university-item","description":"\nDie Philipps-Universität Marburg gehört zu den ältesten Universitäten Deutschlands und vereint starke Forschung in den Naturwissenschaften, den Geisteswissenschaften und der Medizin.","image_quality":"","additional_info":"[Hier geht's zum Gründungsservice MAFEX](https://www.uni-marburg.de/de/fb02/forschung/forschungsinstitute/mafex)\n\n"},{"_uid":"a2de5784-d64d-4704-a800-98f665646c16","name":"Technische Hochschule Mittelhessen  - THINK","image":{"id":136849654708220,"alt":"","name":"","focus":"","title":"","