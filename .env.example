# PostgreSQL connection string (Postgres 17)
# With the bundled local dev database (npm run db:start) this is:
DATABASE_URL="postgresql://lovedis:lovedis@localhost:5433/lovedis"

# NextAuth v5
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
# When RESEND_API_KEY is set, email is sent via Resend; otherwise it logs to
# the console (safe local/dev default). EMAIL_FROM must be a verified sending
# domain in Resend for real delivery. Default: "Lovedis <noreply@lovedis.de>".
RESEND_API_KEY=
EMAIL_FROM=
