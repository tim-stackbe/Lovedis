# PostgreSQL connection string (Postgres 17)
# With the bundled local dev database (npm run db:start) this is:
DATABASE_URL="postgresql://lovedis:lovedis@localhost:5433/lovedis"

# NextAuth v5
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# MCP connector (Claude etc., read-only, /api/mcp). Public origin used in the
# OAuth metadata; must be the URL users enter in Claude. Defaults to
# NEXTAUTH_URL. On Alpha: https://alpha.lovedis.de
MCP_PUBLIC_URL=
# Extra allowed OAuth redirect URIs (comma separated) on top of Claude,
# Cursor and loopback, e.g. https://chatgpt.com/connector_platform_oauth_redirect
MCP_REDIRECT_URIS=

# Email (Resend)
# When RESEND_API_KEY is set, email is sent via Resend; otherwise it logs to
# the console (safe local/dev default). EMAIL_FROM must be a verified sending
# domain in Resend for real delivery. Default: "LOVEDIS <noreply@lovedis.de>".
RESEND_API_KEY=
EMAIL_FROM=
# Support ticket notifications (new tickets + user replies). Falls back to first active ADMIN.
SUPPORT_ADMIN_EMAIL=info@lovedis.de
