generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // Size-optimized query compiler WASM (~half the size of the default "fast"
  // build). Keeps the Cloudflare Worker bundle under the size limit; same
  // base64+WebAssembly.Module loader works under both Node and workerd.
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
  BUSINESS_PARTNER
  INVESTOR
  STARTUP
}

enum StartupStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  GROWTH
}

enum PipelineStage {
  DISCOVERED
  SCREENING
  IN_EVALUATION
  PILOT
  PARTNERED
  PASSED
}

// Technology-radar fields — aligned to the LOVEDIS Challenge verticals used in
// the "Strategischer Ökosystem-Fit" criterion. CONSTRUCTION (Bau), HEALTH_TECH
// and INDUSTRY are the core verticals; AI_DATA (KI & Daten) and CLIMATE_ENERGY
// (Klima & Energie) are cross-cutting fields. This classification stays MANUAL
// and is independent of the weighted score.
enum RadarQuadrant {
  AI_DATA
  CLIMATE_ENERGY
  CONSTRUCTION
  HEALTH_TECH
  INDUSTRY
}

enum RadarRing {
  ADOPT
  TRIAL
  ASSESS
  HOLD
}

// LOVEDIS Challenge Program — 6-criteria weighted matrix (each rated 0–5).
// Weights live in src/lib/constants.ts (CHALLENGE_WEIGHTS) and must sum to 100%.
enum ScoreDimension {
  CHALLENGE_FIT            // 30% — how precisely the startup solves the challenge
  MATURITY_FEASIBILITY     // 20% — technology/pilot readiness, PoC speed
  TEAM_EXECUTION           // 15% — competence, completeness, delivery ability
  MARKET_SCALABILITY       // 15% — market size, transferability, growth
  STRATEGIC_ECOSYSTEM_FIT  // 10% — fit to verticals & hub partners
  TRACTION_REFERENCES      // 10% — customers, pilots, revenue, validated cases
}

// Recommendation is recalculated from the weighted total (see src/lib/scoring.ts).
// The 4-band challenge scheme uses STRONG_YES / YES / NO / STRONG_NO. MAYBE is
// retained for backwards compatibility (old data / DB default) but is no longer
// produced by the scoring engine.
enum Recommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum AttachmentType {
  LINK
  DOCUMENT
  DECK
  OTHER
}

enum ChallengeStatus {
  DRAFT
  OPEN
  IN_REVIEW
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PoCStatus {
  PLANNED
  RUNNING
  COMPLETED
  CANCELLED
}

enum UpdateCategory {
  MILESTONE
  FUNDING
  PRODUCT
  TEAM
  PRESS
  GENERAL
}

enum IntroStatus {
  PENDING
  APPROVED
  DECLINED
  CONNECTED
}

// --- Partner/Startup-SSOT & Screening platform (Plan: partner-startup-ssot) ---

enum PartnerVerdict {
  PENDING  // noch nicht entschieden
  CONTINUE // „spannend, weitermachen"
  PASS     // „nicht weiter"
}

enum SourceType {
  INBOUND
  OUTBOUND
}

enum ReminderStatus {
  SCHEDULED
  SENT
  DONE
  CANCELLED
}

enum EngagementStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum ContentAudience {
  PARTNER
  STARTUP
  BOTH
}

enum CreditTxType {
  GRANT      // Gutschrift
  SPEND      // Verbrauch
  ADJUSTMENT // Korrektur
}

// --- Startup-Marktplatz (Plan: plan-startup-marketplace) ---

enum MarketplaceOfferingType {
  PROGRAM        // Exklusive Programme — 0 Credits
  MENTOR_SESSION // Mentor:innen-Netzwerk — Credits
  SUPPORT        // Individuelle Support-Angebote — Credits
}

enum SupportCategory {
  FUNDRAISING
  LEGAL
  MARKETING
  PRODUCT_TECH
  SALES
  OTHER
}

enum ProgramStatus {
  DRAFT
  OPEN   // im Marktplatz sichtbar/anfragbar
  CLOSED
}

enum BookingStatus {
  REQUESTED       // Startup hat angefragt
  IN_COORDINATION // LOVEDIS koordiniert mit Partner/Mentor
  CONFIRMED       // Termin bestätigt → Credits werden eingelöst
  COMPLETED       // Session/Workshop fand statt
  DECLINED        // Team lehnt ab (kein Credit-Abzug)
  CANCELLED       // Startup/Team storniert (ggf. Rückbuchung)
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  company      String?
  // Partner approval gate: self-registered BUSINESS_PARTNER accounts start
  // null (= pending) and cannot reach partner-facing data until an admin
  // approves them. All other roles (and admin-created users) are set to now()
  // at creation, so they are never gated.
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedStartup       Startup?              @relation("StartupOwner")
  evaluations        Evaluation[]          @relation("Evaluator")
  challenges         Challenge[]           @relation("ChallengeCreator")
  trackedPoCs        PoCPerformance[]      @relation("PoCTracker")
  sharedScoringsIn   SharedScoring[]       @relation("ScoringRecipient")
  sharedScoringsOut  SharedScoring[]       @relation("ScoringSharer")
  conversations      ConversationParticipant[] @relation("ConversationMember")
  messages           Message[]                 @relation("MessageSender")
  follows            StartupFollow[]           @relation("UserFollows")
  authoredUpdates    StartupUpdate[]           @relation("UpdateAuthor")
  introRequests      IntroRequest[]            @relation("IntroInvestor")
  handledIntros      IntroRequest[]            @relation("IntroHandler")

  // Partner/Startup-SSOT
  partnerReviews     PartnerStartupReview[]    @relation("PartnerReviewer")
  screenedStartups   Startup[]                 @relation("StartupScreener")
  pushesReceived     StartupPush[]             @relation("PushPartner")
  pushesAuthored     StartupPush[]             @relation("PushAuthor")
  checkInReminders   CheckInReminder[]         @relation("ReminderPartner")
  partnerEngagements Engagement[]              @relation("EngagementPartner")
  createdEngagements Engagement[]              @relation("EngagementCreator")
  creditTxAuthored   CreditTransaction[]       @relation("CreditTxAuthor")

  // Startup-Marktplatz
  programsCreated    Program[]            @relation("ProgramCreator")
  mentorProfile      MentorProfile?       @relation("MentorUser")
  bookingsRequested  MarketplaceBooking[] @relation("BookingRequester")
  bookingsHandled    MarketplaceBooking[] @relation("BookingHandler")

  @@index([role])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Venture Scout module
// ---------------------------------------------------------------------------

model ScoutingCampaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  startups Startup[]

  @@index([name])
}

model Startup {
  id            String         @id @default(cuid())
  name          String
  website       String?
  description   String
  industry      String
  country       String?
  city          String?
  foundedYear   Int?
  teamSize      Int?
  stage         StartupStage   @default(SEED)
  fundingRaised Float?         // in EUR millions
  pipelineStage PipelineStage  @default(DISCOVERED)
  radarQuadrant RadarQuadrant?
  radarRing     RadarRing?

  // Curated, startup-controlled public storefront (visible to investors/partners
  // in the marketplace). Internal scores/evaluations/pipeline stay private.
  tagline        String?
  logoUrl        String?
  publicPitch    String?
  seekingFunding Boolean   @default(false)
  seekingAmount  Float? // target raise in EUR millions
  lookingFor     String[]  @default([]) // e.g. Funding, Piloten, Talent
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?

  // Sourcing provenance (Inbound vs. Outbound screening data).
  sourceType   SourceType?
  sourceDetail String?     // e.g. "Glassdollar", "Inbound-Form", referrer

  // Internal "Erst-Einordnung" — lightweight, kept separate from deep scoring
  // (Variante A from the plan: fields directly on the Startup).
  screenSummary        String?
  screenRecommendation Recommendation?
  screenedAt           DateTime?
  screenedById         String?
  screenedBy           User?           @relation("StartupScreener", fields: [screenedById], references: [id], onDelete: SetNull)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaignId String?
  campaign   ScoutingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  ownerUserId String? @unique
  owner       User?   @relation("StartupOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  contacts      Contact[]
  attachments   Attachment[]
  evaluations   Evaluation[]
  applications  ChallengeApplication[]
  followers     StartupFollow[]
  updates       StartupUpdate[]
  introRequests IntroRequest[]

  // Partner/Startup-SSOT
  partnerReviews PartnerStartupReview[]
  pushes         StartupPush[]
  reminders      CheckInReminder[]
  engagements    Engagement[]
  creditAccount  CreditAccount?

  // Startup-Marktplatz
  bookings       MarketplaceBooking[]

  @@index([name])
  @@index([industry])
  @@index([pipelineStage])
  @@index([radarQuadrant, radarRing])
  @@index([stage])
  @@index([isPublished])
  @@index([sourceType])
}

model Contact {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startupId])
}

model Attachment {
  id        String         @id @default(cuid())
  startupId String
  startup   Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      AttachmentType @default(LINK)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([startupId])
}

model Evaluation {
  id             String         @id @default(cuid())
  startupId      String
  startup        Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  evaluatorId    String
  evaluator      User           @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  overallScore   Float          @default(0)
  recommendation Recommendation @default(STRONG_NO)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  scores  Score[]
  sharing SharedScoring[]

  @@index([startupId])
  @@index([evaluatorId])
  @@index([overallScore])
}

model Score {
  id           String         @id @default(cuid())
  evaluationId String
  evaluation   Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  dimension    ScoreDimension
  value        Int            @default(0) // 0–5
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([evaluationId, dimension])
  @@index([evaluationId])
}

// ---------------------------------------------------------------------------
// Challenge system
// ---------------------------------------------------------------------------

model Challenge {
  id          String          @id @default(cuid())
  title       String
  description String
  status      ChallengeStatus @default(DRAFT)
  deadline    DateTime?
  tags        String[]        @default([])
  createdById String
  createdBy   User            @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  applications   ChallengeApplication[]
  partnerReviews PartnerStartupReview[]

  @@index([status])
  @@index([createdById])
}

model ChallengeApplication {
  id          String            @id @default(cuid())
  challengeId String
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  startupId   String
  startup     Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pitch       String
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  poc PoCPerformance?

  @@unique([challengeId, startupId])
  @@index([challengeId])
  @@index([startupId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model PoCPerformance {
  id            String               @id @default(cuid())
  applicationId String               @unique
  application   ChallengeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  status        PoCStatus            @default(PLANNED)
  kpis          Json                 @default("[]") // [{ name, target, current, unit }]
  milestones    Json                 @default("[]") // [{ title, dueDate, done }]
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  trackedById   String
  trackedBy     User                 @relation("PoCTracker", fields: [trackedById], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([trackedById])
  @@index([status])
}

model SharedScoring {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User       @relation("ScoringRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sharedById   String
  sharedBy     User       @relation("ScoringSharer", fields: [sharedById], references: [id], onDelete: Cascade)
  message      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([evaluationId, recipientId])
  @@index([recipientId])
  @@index([sharedById])
}

// ---------------------------------------------------------------------------
// Messaging (direct 1:1 conversations)
// ---------------------------------------------------------------------------

model Conversation {
  id            String   @id @default(cuid())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationMember", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Ecosystem — discovery, following, updates & brokered intros
// ---------------------------------------------------------------------------

model StartupFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFollows", fields: [userId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, startupId])
  @@index([userId])
  @@index([startupId])
}

model StartupUpdate {
  id        String         @id @default(cuid())
  startupId String
  startup   Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  UpdateCategory @default(GENERAL)
  createdAt DateTime       @default(now())

  @@index([startupId, createdAt])
  @@index([createdAt])
}

model IntroRequest {
  id             String      @id @default(cuid())
  investorId     String
  investor       User        @relation("IntroInvestor", fields: [investorId], references: [id], onDelete: Cascade)
  startupId      String
  startup        Startup     @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message        String
  status         IntroStatus @default(PENDING)
  handledById    String?
  handledBy      User?       @relation("IntroHandler", fields: [handledById], references: [id], onDelete: SetNull)
  conversationId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([investorId, startupId])
  @@index([startupId])
  @@index([investorId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Screening — partner verdict feedback (central screening signal)
// ---------------------------------------------------------------------------

model PartnerStartupReview {
  id          String         @id @default(cuid())
  partnerId   String
  partner     User           @relation("PartnerReviewer", fields: [partnerId], references: [id], onDelete: Cascade)
  startupId   String
  startup     Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  challengeId String? // optional Use-Case reference (Journey 1b)
  challenge   Challenge?     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  verdict     PartnerVerdict @default(PENDING)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([partnerId, startupId, challengeId])
  @@index([startupId])
  @@index([partnerId])
  @@index([challengeId])
  @@index([verdict])
}

// ---------------------------------------------------------------------------
// Accelerator-independent push + automated check-in reminders
// ---------------------------------------------------------------------------

model StartupPush {
  id         String   @id @default(cuid())
  partnerId  String
  partner    User     @relation("PushPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  startupId  String
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pushedById String
  pushedBy   User     @relation("PushAuthor", fields: [pushedById], references: [id], onDelete: Cascade)
  context    String?
  createdAt  DateTime @default(now())

  reminders CheckInReminder[]

  @@unique([partnerId, startupId])
  @@index([partnerId])
  @@index([startupId])
}

model CheckInReminder {
  id        String         @id @default(cuid())
  partnerId String
  partner   User           @relation("ReminderPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  startupId String?
  startup   Startup?       @relation(fields: [startupId], references: [id], onDelete: SetNull)
  pushId    String?
  push      StartupPush?   @relation(fields: [pushId], references: [id], onDelete: SetNull)
  dueAt     DateTime
  status    ReminderStatus @default(SCHEDULED)
  sentAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([status, dueAt])
  @@index([partnerId])
}

// ---------------------------------------------------------------------------
// Accelerator-independent collaboration ("Engagement" — Oberbegriff für PoC)
// ---------------------------------------------------------------------------

model Engagement {
  id          String           @id @default(cuid())
  partnerId   String
  partner     User             @relation("EngagementPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  startupId   String
  startup     Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title       String
  status      EngagementStatus @default(ACTIVE)
  kpis        Json             @default("[]") // [{ name, target, current, unit }]
  milestones  Json             @default("[]") // [{ title, dueDate, done }]
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdById String
  createdBy   User             @relation("EngagementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([partnerId])
  @@index([startupId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Partner-SSOT content (Notion replacement)
// ---------------------------------------------------------------------------

model RoadmapItem {
  id        String          @id @default(cuid())
  title     String
  body      String?
  phase     String? // e.g. "Q3 2026" / batch name
  status    RoadmapStatus   @default(PLANNED)
  audience  ContentAudience @default(PARTNER)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([audience])
  @@index([status])
}

model ContentPage {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  body        String // Markdown
  audience    ContentAudience @default(PARTNER)
  isPublished Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([audience])
  @@index([isPublished])
}

model MediaAsset {
  id        String          @id @default(cuid())
  name      String
  url       String
  type      AttachmentType  @default(DOCUMENT)
  audience  ContentAudience @default(PARTNER)
  createdAt DateTime        @default(now())

  @@index([audience])
}

// ---------------------------------------------------------------------------
// Venture Credit System (Startup-Venture-Platform)
// ---------------------------------------------------------------------------

model CreditAccount {
  id        String   @id @default(cuid())
  startupId String   @unique
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // cached running total of transactions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]
}

model CreditTransaction {
  id          String        @id @default(cuid())
  accountId   String
  account     CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        CreditTxType
  amount      Int // positive = grant, negative = spend
  reason      String
  createdById String?
  createdBy   User?         @relation("CreditTxAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  // 1:1 back-reference: which marketplace booking triggered this SPEND/refund.
  redeemedBooking MarketplaceBooking? @relation("BookingRedemption")

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Startup-Marktplatz — Kataloge (Programme, Mentor:innen, Support-Angebote)
// + Buchungs-Lifecycle mit Verzahnung in den Venture-Credit-Ledger.
// ---------------------------------------------------------------------------

model Program {
  id          String        @id @default(cuid())
  title       String
  summary     String
  description String
  focusTags   String[]      @default([])
  status      ProgramStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  // Programme sind INKLUSIVE → keine Credits (offeringType=PROGRAM ⇒ creditCost=0).
  createdById String
  createdBy   User          @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bookings    MarketplaceBooking[]

  @@index([status])
}

model MentorProfile {
  id          String   @id @default(cuid())
  // Optionaler Login-Bezug: Mentor:in kann ein User-Konto haben.
  userId      String?  @unique
  user        User?    @relation("MentorUser", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  company     String?
  role        String?
  expertise   String[] @default([])
  bio         String?
  photoUrl    String?
  creditCost  Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    MarketplaceBooking[]

  @@index([isActive])
}

model SupportOffering {
  id          String          @id @default(cuid())
  title       String
  category    SupportCategory @default(OTHER)
  summary     String
  description String
  format      String?
  creditCost  Int             @default(0)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings    MarketplaceBooking[]

  @@index([category])
  @@index([isActive])
}

model MarketplaceBooking {
  id            String                  @id @default(cuid())
  offeringType  MarketplaceOfferingType
  status        BookingStatus           @default(REQUESTED)

  // Anfragendes Startup (Self-Service)
  startupId     String
  startup       Startup                 @relation(fields: [startupId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                    @relation("BookingRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  // Genau EINE Ziel-Referenz ist gesetzt (je nach offeringType).
  programId     String?
  program       Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  mentorId      String?
  mentor        MentorProfile?          @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  offeringId    String?
  offering      SupportOffering?        @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  // Anfrage-Formular
  message       String
  contactName   String
  contactEmail  String
  preferredAt   String?

  // Preis-Snapshot bei Anfrage (Programme: 0). Erst bei CONFIRMED entsteht die
  // SPEND-CreditTransaction; deren id wird hier verlinkt (volle Nachvollziehbarkeit).
  creditCost          Int                @default(0)
  creditTransactionId String?            @unique
  creditTransaction   CreditTransaction? @relation("BookingRedemption", fields: [creditTransactionId], references: [id], onDelete: SetNull)

  // Team-Koordination
  handledById     String?
  handledBy       User?                 @relation("BookingHandler", fields: [handledById], references: [id], onDelete: SetNull)
  coordinatorNote String?

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status])
  @@index([startupId])
  @@index([offeringType])
}
